{
  "schema": "sonde-wire/1",
  "authority": "firmware is the wire authority; this file is the single source of truth. A wire change = edit this file in the SAME commit, regenerate the artifacts (make -C tests/host wiregen), and let the drift gates in both repos prove agreement.",
  "conventions": {
    "endianness": "little",
    "note": "All multibyte fields are little-endian (D9). CRC integrity fields cover the stated byte range. Offsets are byte offsets from the start of the frame/record."
  },
  "frames": [
    {
      "name": "heartbeat",
      "f_port": 10,
      "direction": "uplink",
      "format_version": 2,
      "summary": "Mission heartbeat v2 (D2/D4, #33). SF10 maximum range. 11 bytes, exact fit at US915 DR0.",
      "total_length": 11,
      "length_rule": "fixed",
      "fields": [
        { "name": "timestamp_min", "offset": 0, "type": "u16", "unit": "min", "comment": "minutes since mission epoch; wraps ~45.5 days (see status bit5 TS_WRAP)" },
        { "name": "latitude_raw", "offset": 2, "type": "i16", "scale": "x*90/32767", "unit": "deg" },
        { "name": "longitude_raw", "offset": 4, "type": "i16", "scale": "x*180/32767", "unit": "deg" },
        { "name": "temperature_raw", "offset": 6, "type": "u8", "scale": "(x-64)*2", "unit": "degC" },
        { "name": "press_hum", "offset": 7, "type": "u16", "bitfield": [
          { "name": "pressure_raw", "lsb": 0, "bits": 11, "unit": "hPa", "sentinel": { "value": 2047, "meaning": "invalid" } },
          { "name": "humidity_raw", "lsb": 11, "bits": 5, "scale": "x*5", "unit": "%", "sentinel": { "value": 31, "meaning": "invalid" } }
        ] },
        { "name": "battery_raw", "offset": 9, "type": "u8", "scale": "x*0.050", "unit": "V" },
        { "name": "status", "offset": 10, "type": "u8", "bitfield": [
          { "name": "gps_stale", "lsb": 0, "bits": 1 },
          { "name": "temp_stale", "lsb": 1, "bits": 1 },
          { "name": "humidity_stale", "lsb": 2, "bits": 1 },
          { "name": "pressure_stale", "lsb": 3, "bits": 1 },
          { "name": "time_gnss_disciplined", "lsb": 4, "bits": 1 },
          { "name": "timestamp_wrapped", "lsb": 5, "bits": 1 },
          { "name": "mission_state", "lsb": 6, "bits": 2, "enum": { "0": "COMMISSIONING", "1": "ASCENT", "2": "FLOAT", "3": "RESERVED" } }
        ] }
      ],
      "integrity": [],
      "golden_vectors": [
        {
          "bytes_hex": "C832FF3FF0AE4CF54B6410",
          "expect": {
            "timestamp_min": 13000,
            "latitude_deg": 44.99862666707358,
            "longitude_deg": -113.99761955626087,
            "temperature_degC": 24,
            "pressure_hPa": 1013,
            "humidity_pct": 45,
            "battery_voltage_V": 5.0,
            "mission_state": 0,
            "gps_stale": false
          }
        }
      ]
    },
    {
      "name": "archive_record_v6",
      "f_port": 11,
      "direction": "uplink",
      "format_version": 6,
      "summary": "One high-resolution archive record (34 bytes, v6, STAB-04/#151) as carried inside a bulk burst. SF7.",
      "record_length": 34,
      "fields": [
        { "name": "timestamp", "offset": 0, "type": "u32", "unit": "s", "comment": "unix epoch seconds at write time" },
        { "name": "latitude_raw", "offset": 4, "type": "i32", "scale": "x*90/8388607", "unit": "deg", "comment": "sensor_t binary" },
        { "name": "longitude_raw", "offset": 8, "type": "i32", "scale": "x*180/8388607", "unit": "deg", "comment": "sensor_t binary" },
        { "name": "altitude_m", "offset": 12, "type": "u16", "unit": "m" },
        { "name": "temperature_raw", "offset": 14, "type": "i16", "scale": "x*0.1", "unit": "degC" },
        { "name": "humidity_raw", "offset": 16, "type": "u16", "scale": "x*0.1", "unit": "%" },
        { "name": "pressure_raw", "offset": 18, "type": "u16", "scale": "x*0.1", "unit": "hPa" },
        { "name": "battery_mv", "offset": 20, "type": "u16", "unit": "mV" },
        { "name": "solar_mv", "offset": 22, "type": "u16", "unit": "mV" },
        { "name": "voltage_slope", "offset": 24, "type": "i16", "unit": "mV/h", "sentinel": { "value": -32768, "meaning": "not computed (PWR-SIMPLIFY 2026-08-24: ladder deleted; field reserved, layout unchanged)" } },
        { "name": "satellites", "offset": 26, "type": "u8", "comment": "AUTHORITATIVE satellite count" },
        { "name": "hdop_raw", "offset": 27, "type": "u8", "scale": "x*0.1", "unit": "HDOP" },
        { "name": "power_mode", "offset": 28, "type": "u8", "comment": "AUTHORITATIVE operating mode enum" },
        { "name": "flags", "offset": 29, "type": "u8", "comment": "redundant copy: b0 gps_fix_valid, b1-b4 sats, b5-b7 power_mode; prefer satellites/power_mode fields", "bitfield": [
          { "name": "gps_fix_valid", "lsb": 0, "bits": 1 },
          { "name": "sats_copy", "lsb": 1, "bits": 4 },
          { "name": "power_mode_copy", "lsb": 5, "bits": 3 }
        ] },
        { "name": "sensor_quality", "offset": 30, "type": "u8", "bitfield": [
          { "name": "press_stale", "lsb": 0, "bits": 1 },
          { "name": "temp_stale", "lsb": 1, "bits": 1 },
          { "name": "hum_stale", "lsb": 2, "bits": 1 },
          { "name": "gnss_stale", "lsb": 3, "bits": 1 },
          { "name": "batt_stale", "lsb": 4, "bits": 1 },
          { "name": "reserved", "lsb": 5, "bits": 3 }
        ] },
        { "name": "veto_reason", "offset": 31, "type": "u8", "comment": "TransmitVeto_t at write time (0 = none)" },
        { "name": "crc16", "offset": 32, "type": "u16" }
      ],
      "integrity": [
        { "algo": "crc16-modbus", "field": "crc16", "offset": 32, "cover": "0..31", "comment": "CRC-16/MODBUS (poly 0xA001 reflected, init 0xFFFF) over record bytes 0..31" }
      ]
    },
    {
      "name": "bulk_packet_v6",
      "f_port": 11,
      "direction": "uplink",
      "format_version": 6,
      "summary": "Bulk archive burst envelope (v6, STAB-04/#151 + STAB-05/#152). [0x06][count][count x (seq u32 LE + 34B record)][crc32]. Length = 6 + 38*count.",
      "length_rule": "6 + 38*count",
      "fields": [
        { "name": "packet_type", "offset": 0, "type": "u8", "const": 6, "comment": "version discriminator" },
        { "name": "count", "offset": 1, "type": "u8", "comment": "number of records" },
        { "name": "records", "offset": 2, "type": "array", "count_from": "count", "element": { "seq": "u32", "record": "archive_record_v6" } }
      ],
      "integrity": [
        { "algo": "crc32-iso-hdlc", "offset": "len-4", "cover": "0..len-5", "comment": "CRC-32/ISO-HDLC (zlib) over all preceding bytes" }
      ]
    },
    {
      "name": "version_report",
      "f_port": 20,
      "direction": "uplink",
      "format_version": 1,
      "summary": "Version report (A-005/#79): device announces fw version + heartbeat format version at commissioning and first-flight admission. 12 bytes LE.",
      "total_length": 12,
      "length_rule": "fixed",
      "fields": [
        { "name": "magic", "offset": 0, "type": "u8", "const": 86, "comment": "'V' = 0x56" },
        { "name": "fw_major", "offset": 1, "type": "u8" },
        { "name": "fw_minor", "offset": 2, "type": "u8" },
        { "name": "fw_patch", "offset": 3, "type": "u8" },
        { "name": "heartbeat_format_version", "offset": 4, "type": "u8" },
        { "name": "stage", "offset": 5, "type": "u8", "enum": { "1": "COMMISSIONING", "2": "FLIGHT" } },
        { "name": "mission_minutes", "offset": 6, "type": "u32", "unit": "min" },
        { "name": "crc16", "offset": 10, "type": "u16" }
      ],
      "integrity": [
        { "algo": "crc16-ccitt-false", "field": "crc16", "offset": 10, "cover": "0..9", "comment": "CRC-16/CCITT-FALSE (poly 0x1021, init 0xFFFF, non-reflected) over bytes 0..9. DIFFERENT from the record CRC (MODBUS)." }
      ],
      "golden_vectors": [
        {
          "note": "fw 1.0.0, heartbeat fmt 2, stage COMMISSIONING, mission 1234 min; CRC-16/CCITT-FALSE over first 10 bytes = 0x2793.",
          "bytes_hex": "560100000201D20400009327",
          "expect": { "magic": 86, "fw_major": 1, "fw_minor": 0, "fw_patch": 0, "heartbeat_format_version": 2, "stage": 1, "mission_minutes": 1234, "crc16": 10131 }
        }
      ]
    }
  ]
}
