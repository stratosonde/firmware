# Build artifacts
Debug/
*.o
*.elf
*.map
*.list
*.su
*.d
*.cyclo
# ...but keep the build system itself so a fresh clone can build (R49):
# Debug/Makefile, objects.list, objects.mk, sources.mk and all live subdir.mk
# are force-added and tracked. New source dirs need `git add -f` on their subdir.mk.

# Host test binaries (out-of-tree since Phase 1 / PIPE-01; ignore the
# configuration build dirs, not broad source-name patterns)
tests/host/build/

# IDE files
.settings/
*.launch
# CubeIDE managed-build output (the IDE generates its own lowercase makefile,
# which case-clashes with the tracked Debug/Makefile on Windows; the IDE
# builder is therefore pointed at IDE/<config> in .cproject)
IDE/
# GUI-created build-configuration output folders (e.g. US915/)
/US915/

# Temporary files
*.tmp
*.temp
fix_instructions.txt

# Documentation files (should be in docs/)
*.pdf

# Reference materials
Reference/
datasheets/

# Archive folder (old debug notes) — root only; docs/archive/ IS tracked (review ledgers)
/archive/
# (docs/archive/ files are tracked intentionally)

# OS files
.DS_Store
Thumbs.db

# STM32CubeIDE specific
.metadata/
.recommenders/

# F6: real LoRaWAN keys - never commit (DDR-0018)
LoRaWAN/App/se-identity.h
.aider*

# Error-log scratch files
*_err.txt

# Local-only LLM workflow notes (never commit, per file header)
docs/temp/

# F-009 (#209): flight build artifacts
dist/


__pycache__/
*.pyc
